{
  "format": "sfxgen/1",
  "name": "Laser zap",
  "description": "A falling detuned saw through a closing resonant filter, folded for bite, with a puff of air.",
  "tags": ["scifi", "weapon", "laser", "zap"],
  "duration": "auto",
  "seed": 3,
  "tracks": [
    {
      "id": "zap",
      "source": {
        "type": "osc", "wave": "saw", "freq": [[0, 2400], [0.25, 180]], "unison": 3, "detune": 20,
        "env": { "attack": 0.001, "decay": 0.3 },
        "filter": { "mode": "lowpass", "cutoff": [[0, 9000], [0.3, 800]], "q": 3 }
      },
      "fx": [{ "type": "drive", "id": "bite", "mode": "fold", "amount": 10 }]
    },
    { "id": "air", "gain": -8, "source": { "type": "noise", "color": "pink", "env": { "attack": 0.001, "decay": 0.12 }, "filter": { "mode": "bandpass", "cutoff": 3000, "q": 1 } } }
  ],
  "controls": [
    { "id": "pitch", "label": "Pitch", "hint": "Low blaster to high pew.", "value": 0.5, "targets": [{ "path": "tracks.zap.source.freq", "mode": "mul", "from": 0.4, "to": 2.2 }] },
    { "id": "speed", "label": "Speed", "hint": "How fast the shot falls.", "value": 0.5, "targets": [{ "path": "tracks.zap.source.freq", "mode": "stretch", "from": 2.5, "to": 0.4 }, { "path": "tracks.zap.source.env", "mode": "stretch", "from": 2.5, "to": 0.4 }] },
    { "id": "bite", "label": "Bite", "hint": "Clean beam to buzzing, folded grit.", "value": 0.4, "targets": [{ "path": "tracks.zap.fx.bite.amount", "from": 0, "to": 26 }] }
  ]
}
