        "exciter": { "kind": "scrape", "hardness": 0.75, "duration": 0.14, "density": [[0, 520], [0.14, 160]], "roughness": 0.3 }
      }
    },
    {
      "id": "slam",
      "note": "Slide home: steel on steel, a bar this time so it has a pitch different from the magazine. The loudest moment.",
      "start": 0.41,
      "gain": 2,
      "source": {
        "type": "modal",
        "material": "metal",
        "shape": "bar",
        "freq": 1040,
        "decay": 0.1,
        "damping": 1.8,
        "dent": 0.35,
