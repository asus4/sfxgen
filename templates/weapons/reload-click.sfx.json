      "fx": [{ "type": "transient", "attack": 4.8, "window": 0.005 }]
    },
    {
      "id": "spring",
      "note": "The recoil spring ringing after the slam: a very stiff string, choked quickly. Small, but it is the detail that says 'mechanism'.",
      "start": 0.413,
      "gain": -24.8,
      "source": {
        "type": "pluck",
        "freq": 137,
        "decay": 0.269,
        "stiffness": 0.92,
