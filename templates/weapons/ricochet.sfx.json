{
  "format": "sfxgen/1",
  "name": "Ricochet",
  "description": "A rifle bullet glances off a steel girder in a canyon and whines away. 0 ms: the strike, a hard bright tick on thick steel, and a puff of grit. 5 ms: the deformed slug tumbles off, and its spin sings: a wiry tone that starts at 3.6 kHz and slides down to 900 Hz over 700 ms, wobbling faster and faster as the tumble speeds up, flying away from you so it also dulls and fades. A single canyon echo repeats the whine, darker.",
  "tags": ["weapon", "ricochet", "bullet", "gun", "whine", "deflect", "western", "ping", "impact"],
  "duration": "auto",
  "seed": 18,
  "tracks": [
    {
      "id": "strike",
      "note": "Lead on steel: tiny object, huge force. A small damped bar, struck as hard as possible.",
      "source": {
        "type": "modal",
        "material": "metal",
        "shape": "bar",
        "freq": 2150,
        "decay": 0.12,
        "damping": 1.8,
        "modes": 14,
        "dent": 0.5,
        "position": 0.9,
        "exciter": { "kind": "impulse", "hardness": 1 }
      },
      "gain": -13
    },
    {
      "id": "whine",
      "note": "The tumbling slug: a stiff bowed wire, not an oscillator, so the tone is ragged and has rushing air in it. The pitch falls; the wobble (the tumble) speeds up from 9 to 30 Hz.",
      "start": 0.005,
      "source": {
        "type": "pluck",
        "excite": "bow",
        "bowTime": 0.75,
        "decay": 0.25,
        "brightness": 0.9,
        "position": 0.06,
        "stiffness": 0.5,
        "hardness": 0.8,
        "freq": {
          "env": [[0, 3600], [0.06, 3100], [0.75, 900, 0.3]],
          "mod": [{ "type": "lfo", "shape": "sine", "rate": [[0, 9], [0.75, 30]], "depth": 1.1, "unit": "st" }]
        }
      },
      "fx": [
        { "type": "tremolo", "rate": [[0, 9], [0.75, 30]], "depth": 0.45 },
        { "type": "doppler", "id": "away", "speed": 60, "distance": 3, "time": 0, "direction": "front-to-back", "amount": 0.5, "air": 2 },
        { "type": "delay", "id": "canyon", "time": 310, "feedback": 0.297, "tone": 2400, "mix": 0.27 }
      ]
    },
    {
      "id": "grit",
      "note": "Paint, rust and lead dust knocked off: a short burst of dry ticks. Places the hit on a real surface.",
      "start": 0.004,
      "gain": -18,
      "source": {
        "type": "particles",
        "distribution": "burst",
        "density": 500,
        "duration": 0.09,
        "grain": { "kind": "tick", "lo": 1500, "hi": 8000, "decayLo": 0.002, "decayHi": 0.012, "levelJitter": 14 }
      }
    }
  ],
  "controls": [
    {
      "id": "pitch",
      "label": "Calibre",
      "hint": "A small fast round's thin zing to a heavy slug's low moan.",
      "value": 0.5,
      "vary": 0.12,
      "targets": [
        { "path": "tracks.whine.source.freq.env", "mode": "mul", "from": 1.7, "to": 0.5 },
        { "path": "tracks.strike.source.freq", "mode": "mul", "from": 1.5, "to": 0.6 }
      ]
    },
    {
      "id": "length",
      "label": "Whine length",
      "hint": "A quick 'pting' to a long cartoon-western peeeoww.",
      "value": 0.5,
      "vary": 0.1,
      "targets": [
        { "path": "tracks.whine.source.bowTime", "mode": "mul", "from": 0.3, "to": 2.4 },
        { "path": "tracks.whine.source.freq.env", "mode": "stretch", "from": 0.3, "to": 2.4 },
        { "path": "tracks.whine.source.freq.mod.0.rate", "mode": "stretch", "from": 0.3, "to": 2.4 },
        { "path": "tracks.whine.fx.0.rate", "mode": "stretch", "from": 0.3, "to": 2.4 }
      ]
    },
    {
      "id": "tumble",
      "label": "Tumble",
      "hint": "A clean spinning zing to a wildly wobbling, deformed slug.",
      "value": 0.5,
      "targets": [{ "path": "tracks.whine.source.freq.mod.0.depth", "from": 0, "to": 2.2 }, { "path": "tracks.whine.fx.0.depth", "from": 0.05, "to": 0.85 }]
    },
    {
      "id": "surface",
      "label": "Surface",
      "hint": "What it hit.",
      "widget": "select",
      "value": 0,
      "options": [
        {
          "label": "Steel",
          "set": {
            "tracks.strike.source.material": "metal",
            "tracks.strike.source.shape": "bar",
            "tracks.strike.source.freq": 2150,
            "tracks.strike.source.decay": 0.12,
            "tracks.grit.gain": -18
          }
        },
        {
          "label": "Rock",
          "set": {
            "tracks.strike.source.material": "stone",
            "tracks.strike.source.shape": "random",
            "tracks.strike.source.freq": 900,
            "tracks.strike.source.decay": 0.08,
            "tracks.grit.gain": -10
          }
        },
        {
          "label": "Tin sign",
          "set": {
            "tracks.strike.source.material": "metal",
            "tracks.strike.source.shape": "plate",
            "tracks.strike.source.freq": 520,
            "tracks.strike.source.decay": 0.7,
            "tracks.grit.gain": -24
          }
        }
      ]
    },
    {
      "id": "canyon",
      "label": "Canyon",
      "hint": "No echo, or the whine coming back off far rock walls.",
      "value": 0.45,
      "targets": [
        { "path": "tracks.whine.fx.canyon.mix", "from": 0, "to": 0.6, "curve": "linear" },
        { "path": "tracks.whine.fx.canyon.feedback", "from": 0.05, "to": 0.6 }
      ]
    }
  ]
}
