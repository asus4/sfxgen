      "start": 0.006,
      "source": {
        "type": "pluck",
        "freq": 560,
        "pitch": [
          [
            0,
            0
          ],
          [
            0.07,
            -5
          ]
        ],
        "decay": 0.4,
        "brightness": 0.35,
        "position": 0.4,
        "hardness": 0.45,
        "mute": 0.2
      }
    },
    {
