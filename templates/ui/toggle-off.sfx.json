{
  "format": "sfxgen/1",
  "name": "Toggle off",
  "description": "The same rocker switch as Toggle on, thrown off. The plastic latch lands lower and duller, and just after it the indicator tone that rose for on falls instead, closing down as it goes, like the light behind the switch dying. Lower and rounder than Toggle on.",
  "tags": ["ui", "toggle", "switch", "off", "disable", "checkbox", "deactivate"],
  "duration": "auto",
  "seed": 8,
  "tracks": [
    {
      "id": "latch",
      "note": "The switch landing: the plastic box of Toggle on, tuned down and hit softer, more thud than tick.",
      "gain": -6,
      "source": {
        "type": "modal",
        "material": "plastic",
        "shape": "box",
        "freq": 900,
        "decay": 0.03,
        "position": 0.6,
        "modes": 12,
        "exciter": {
          "kind": "mallet",
          "hardness": 0.5
        }
      }
    },
    {
      "id": "sag",
      "note": "The state going out: the indicator tone of Toggle on, falling and dimming so it reads as off without looking.",
      "start": 0.006,
      "source": {
        "type": "osc",
        "wave": "triangle",
        "freq": 760,
        "pitch": [[0, 0], [0.06, -7]],
        "env": {
          "attack": 0.004,
          "decay": 0.11487
        },
        "filter": {
          "mode": "lowpass",
          "cutoff": [[0, 2600], [0.07, 900]]
        }
      }
    }
  ],
  "controls": [
    {
      "id": "pitch",
      "label": "Pitch",
      "hint": "A big panel switch to a tiny checkbox.",
      "value": 0.5,
      "targets": [
        {
          "path": "tracks.sag.source.freq",
          "mode": "mul",
          "from": 0.5,
          "to": 2
        },
        {
          "path": "tracks.latch.source.freq",
          "mode": "mul",
          "from": 0.6,
          "to": 1.6
        }
      ]
    },
    {
      "id": "fall",
      "label": "Fall",
      "hint": "How far the tone drops: a small nod down to a deep slump.",
      "value": 0.5,
      "targets": [
        {
          "path": "tracks.sag.source.pitch",
          "mode": "mul",
          "from": 0.3,
          "to": 1.7,
          "curve": "linear"
        }
      ]
    },
    {
      "id": "click",
      "label": "Click",
      "hint": "All tone to mostly the dull switch.",
      "value": 0.5,
      "vary": 0.05,
      "targets": [
        {
          "path": "tracks.latch.gain",
          "from": -24,
          "to": 12,
          "curve": "linear"
        }
      ]
    },
    {
      "id": "length",
      "label": "Length",
      "hint": "A choked blip to a tone that sinks slowly.",
      "value": 0.4,
      "targets": [
        {
          "path": "tracks.sag.source.env.decay",
          "from": 0.05,
          "to": 0.4
        }
      ]
    }
  ],
  "master": {
    "normalize": {
      "mode": "peak",
      "target": -3
    }
  }
}
