{
  "format": "sfxgen/1",
  "name": "Hover tick",
  "description": "A pointer passing over an item: the pad of a finger brushing the rim of a thin glass. A breath of skin on the surface, a brief puff of soft air, and under it one small note whose glass overtones die almost at once; a soft front so it never clicks, and gone as soon as it starts. The quietest sound of the kit, set well under the others, because it plays most often.",
  "tags": ["ui", "hover", "tick", "glass", "focus", "rollover", "subtle"],
  "duration": "auto",
  "seed": 2,
  "tracks": [
    {
      "id": "tick",
      "note": "The glass: three partials, the upper two dying fast. Low enough to be a touch, not a beep.",
      "source": {
        "type": "additive",
        "freq": 1830,
        "partials": [
          {
            "id": "f",
            "ratio": 1
          },
          {
            "id": "p2",
            "ratio": 2.32,
            "amp": 0.4
          },
          {
            "id": "p3",
            "ratio": 4.25,
            "amp": 0.18
          }
        ],
        "decay": 0.0401549,
        "damping": 0.6,
        "env": {
          "attack": 0.00131203
        }
      }
    },
    {
      "id": "skin",
      "note": "The fingertip: a short puff of soft noise that makes it a touch on something and not a tone.",
      "gain": -2,
      "source": {
        "type": "noise",
        "color": "pink",
        "env": {
          "attack": 0.00121976,
          "decay": 0.014
        },
        "filter": {
          "mode": "bandpass",
          "cutoff": 3500,
          "q": 0.8
        }
      }
    }
  ],
  "controls": [
    {
      "id": "pitch",
      "label": "Pitch",
      "hint": "Step it up or down per item for a row that plays a scale.",
      "value": 0,
      "min": -12,
      "max": 12,
      "step": 1,
      "unit": "st",
      "vary": 1,
      "targets": [
        {
          "path": "tracks.tick.source.pitch",
          "mode": "add",
          "from": -12,
          "to": 12,
          "curve": "linear"
        }
      ]
    },
    {
      "id": "length",
      "label": "Length",
      "hint": "A dry tick to a small ringing ping.",
      "value": 0.35,
      "targets": [
        {
          "path": "tracks.tick.source.decay",
          "from": 0.015,
          "to": 0.25
        }
      ]
    },
    {
      "id": "glass",
      "label": "Glass",
      "hint": "A plain soft blip to a brighter, glassier touch.",
      "value": 0.4,
      "targets": [
        {
          "path": "tracks.tick.source.partials.p2.amp",
          "from": 0,
          "to": 1,
          "curve": "linear"
        },
        {
          "path": "tracks.tick.source.partials.p3.amp",
          "from": 0,
          "to": 0.45,
          "curve": "linear"
        }
      ]
    },
    {
      "id": "softness",
      "label": "Softness",
      "hint": "A crisp nail tap to a rounded, clickless fade-in.",
      "value": 0.4,
      "targets": [
        {
          "path": "tracks.tick.source.env.attack",
          "from": 0.0003,
          "to": 0.012
        },
        {
          "path": "tracks.skin.source.env.attack",
          "from": 0.0003,
          "to": 0.01
        }
      ]
    },
    {
      "id": "touch",
      "label": "Touch",
      "hint": "A bare glass note to mostly the brush of the fingertip.",
      "value": 0.6,
      "targets": [
        {
          "path": "tracks.skin.gain",
          "from": -20,
          "to": 10,
          "curve": "linear"
        }
      ]
    }
  ],
  "master": {
    "normalize": {
      "mode": "peak",
      "target": -9
    }
