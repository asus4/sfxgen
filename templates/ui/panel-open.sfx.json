{
  "format": "sfxgen/1",
  "name": "Sci-fi panel open",
  "description": "A holographic panel snapping open on a starship display, the way film interfaces sound. Everything rises, brightens and widens, and the weight is after the snap: a rush of swirling air and a rising tonal glide swell out of nothing and land on a light, bright click with a soft sub under it; out of it a glassy chord climbs in quick steps and blooms, still lifting a touch, thrown left and right by a ping-pong echo, while glittering grains rise and thin and a few data pings fill the panel. A large, clean hall. Its pair, Sci-fi panel close, does the opposite.",
  "tags": [
    "ui",
    "panel",
    "sci-fi",
    "scifi",
    "hud",
    "hologram",
    "interface",
    "futuristic",
    "cinematic",
    "menu",
    "window",
    "open",
    "expand",
    "appear"
  ],
  "duration": "auto",
  "seed": 12,
  "output": {
    "channels": 2
  },
  "tracks": [
    {
