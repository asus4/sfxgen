          "freq": {
            "value": 640,
            "mod": [
              {
                "type": "lfo",
                "rate": 0.125,
                "depth": 3.2,
                "unit": "st"
              },
              {
                "type": "lfo",
                "rate": 0.375,
                "depth": 1.8,
