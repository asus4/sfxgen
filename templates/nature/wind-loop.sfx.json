{
  "format": "sfxgen/1",
  "name": "Wind (loop)",
  "description": "Wind over an open hillside with a hut on it: a broad rush of air that swells and falls in gusts every few seconds, a low buffeting underneath when it leans on the walls, and a thin whistle where it gets through a gap in the window frame, rising when the gust does. An 8 s stereo loop; the gusts repeat exactly once per loop (they are tied to 1/8 Hz and its multiples) and the seam is crossfaded over 1 s.",
  "tags": [
    "nature",
    "wind",
    "weather",
    "loop",
    "ambience",
    "storm",
    "howl",
    "air"
  ],
  "duration": 8,
  "loop": {
    "mode": "crossfade",
    "crossfade": 1
  },
  "seed": 9,
  "output": {
    "channels": 2
  },
  "tracks": [
    {
      "id": "rush",
      "note": "The air itself: pink noise whose colour and level rise and fall together with the gusts (one slow, one twice as fast, both whole cycles per loop).",
      "source": {
        "type": "noise",
        "color": "pink",
        "width": 0.8,
        "env": {
          "attack": 0.01
        },
        "filter": {
          "mode": "bandpass",
          "cutoff": {
            "value": 520,
            "mod": [
              {
                "type": "lfo",
                "rate": 0.125,
                "depth": 7,
                "unit": "st"
              },
              {
                "type": "lfo",
                "rate": 0.375,
                "depth": 4,
                "unit": "st"
              },
              {
                "type": "wander",
                "rate": 1.2,
                "depth": 2,
                "unit": "st"
              }
            ]
          },
          "q": 0.8
        }
      },
      "fx": [
        {
          "id": "gust",
          "type": "gain",
          "gain": {
            "value": -4,
            "mod": [
              {
                "type": "lfo",
                "rate": 0.125,
                "depth": 5
              },
              {
                "type": "lfo",
                "rate": 0.375,
                "depth": 3
              }
            ]
          }
        }
      ]
    },
    {
      "id": "buffet",
      "note": "Pressure on the walls and in the ears: slow, irregular low thumping between 60 and 200 Hz. The weight of the wind.",
      "gain": 0,
      "source": {
        "type": "noise",
        "color": "brown",
        "env": {
          "attack": 0.01
        },
        "filter": {
          "mode": "lowpass",
          "cutoff": 190,
          "slope": "24"
        }
      },
      "fx": [
        {
          "type": "tremolo",
          "rate": 3.5,
          "depth": 0.7,
          "shape": "random"
        },
        {
          "id": "gust",
          "type": "gain",
          "gain": {
            "value": -4,
            "mod": [
              {
                "type": "lfo",
                "rate": 0.125,
                "depth": 6
              }
            ]
          }
        }
      ]
    },
    {
      "id": "whistle",
      "note": "The gap in the window frame: noise ringing in a narrow tube, its pitch pushed up by each gust. The detail that gives the wind a voice.",
      "gain": 0,
      "source": {
        "type": "noise",
        "color": "white",
        "width": 0.3,
        "env": {
          "attack": 0.01
        }
      },
      "fx": [
