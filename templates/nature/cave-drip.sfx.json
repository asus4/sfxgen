{
  "format": "sfxgen/1",
  "name": "Cave drip",
  "description": "Deep in a limestone cave, water gathers on a stalactite and falls into a still pool: three drops, the gaps between them growing and never equal, no two the same size. Each is a small wet slap on the surface, the \"plink\" of the bubble it drags under (its pitch flicking upward as the bubble closes) and, a moment later, the smaller droplets it threw up landing around it. The cave answers each one with an echo off the far wall and a long dark wash.",
  "tags": ["nature", "water", "drip", "drop", "cave", "echo", "dungeon", "ambience"],
  "duration": "auto",
  "maxDuration": 6,
  "seed": 30,
  "tracks": [
    {
      "id": "drop",
      "note": "The bubble each drop drags under: a short sine ring whose pitch dips slightly, then flicks upward. Every drop is a different size, so a different note and level: equal plinks read as a sonar.",
      "repeat": {
        "count": 3,
        "interval": 0.614863,
        "accel": 1.17,
        "pitchJitter": 6,
        "velJitter": 0.45
      },
      "sends": {
        "cave": -9
      },
      "source": {
        "type": "osc",
        "wave": "sine",
        "freq": [[0, 1010], [0.012, 930], [0.05, 1720]],
        "env": {
          "attack": 0.0015,
          "decay": 0.0679841
        },
        "pitch": 0.55
      },
      "gain": -3,
      "start": 0.004
    },
    {
      "id": "after",
      "note": "The droplets thrown up by the impact, landing just behind each drop: a handful of smaller, higher bubbles. They share the drop's timing, so they stay attached to it at any rate.",
      "start": 0.062,
      "gain": -5,
      "repeat": {
        "count": 3,
        "interval": 0.614863,
        "accel": 1.17,
        "pitchJitter": 3,
        "velJitter": 0.4
      },
      "sends": {
        "cave": -4
      },
      "source": {
        "type": "particles",
        "distribution": "burst",
        "density": 190,
        "duration": 0.11,
        "grain": {
          "kind": "drop",
          "lo": 1700,
          "hi": 4600,
          "decayLo": 0.008,
          "decayHi": 0.03,
          "levelJitter": 9,
          "size": 0.6
        }
      }
    },
    {
      "id": "surface",
      "note": "The slap on the water surface: a very short burst of wet noise at each impact, darkening as it dies, just ahead of the bubble. It is what makes the plink water and not a tone.",
      "gain": 0,
      "repeat": {
        "count": 3,
        "interval": 0.614863,
        "accel": 1.17,
        "velJitter": 0.35
      },
      "sends": {
        "cave": -6
      },
      "source": {
        "type": "noise",
        "color": "pink",
        "env": {
          "attack": 0.0004,
          "decay": 0.04
        },
        "filter": {
          "mode": "bandpass",
          "cutoff": [[0, 3200], [0.03, 1300]],
          "q": 0.6
        }
      }
    }
  ],
  "buses": [
    {
      "id": "cave",
      "fx": [
        {
          "id": "wall",
          "type": "delay",
          "time": 216.333,
          "feedback": 0.26,
          "tone": 2000,
          "highpass": 300,
          "mix": 0.4
        },
        {
          "id": "space",
          "type": "reverb",
          "space": "cave",
          "decay": 2.36643,
          "damping": 0.8,
          "highcut": 3800,
          "predelay": 25
        }
      ],
      "gain": -7.4
    }
  ],
  "controls": [
    {
      "id": "size",
      "label": "Drop size",
      "hint": "A fine bead to a fat, heavy drop: lower and rounder.",
      "value": 0.45,
      "vary": 0.1,
      "targets": [
        {
          "path": "tracks.drop.source.pitch",
          "mode": "set",
          "from": 10,
          "to": -11
        },
        {
          "path": "tracks.drop.source.env.decay",
          "mode": "set",
          "from": 0.04,
          "to": 0.13
        },
        {
          "path": "tracks.surface.gain",
          "mode": "set",
          "from": -14,
          "via": 0,
          "to": 5
        }
      ],
      "default": 0.45
    },
    {
      "id": "rate",
      "label": "Rate",
      "hint": "A slow, patient drip to a quick trickle.",
      "value": 0.4,
      "targets": [
        {
          "path": "tracks.drop.repeat.interval",
          "mode": "set",
          "from": 1.3,
          "to": 0.2
        },
        {
          "path": "tracks.after.repeat.interval",
          "mode": "set",
          "from": 1.3,
          "to": 0.2
        },
        {
          "path": "tracks.surface.repeat.interval",
          "mode": "set",
          "from": 1.3,
          "to": 0.2
        }
      ]
    },
    {
      "id": "cave",
      "label": "Cave size",
      "hint": "A wet cellar to a vast cavern: longer tail, later echo.",
      "value": 0.5,
      "targets": [
        {
          "path": "buses.cave.fx.space.decay",
          "mode": "set",
          "from": 0.8,
          "to": 7
        },
        {
          "path": "buses.cave.fx.wall.time",
          "mode": "set",
          "from": 90,
          "to": 520
        }
      ]
    },
    {
      "id": "depth",
      "label": "Depth",
      "hint": "Beside the pool to far down the tunnel: the echo takes over from the drop.",
      "value": 0.45,
      "targets": [
        {
          "path": "buses.cave.gain",
          "mode": "set",
          "from": -20,
          "to": 8
        }
      ]
    },
    {
      "id": "spray",
      "label": "Splash",
      "hint": "A clean plink to a messier drop with droplets scattering.",
      "value": 0.4,
      "targets": [
        {
          "path": "tracks.after.gain",
          "mode": "set",
          "from": -24,
          "via": -5,
          "to": 10
        },
        {
          "path": "tracks.after.source.density",
          "mode": "set",
          "from": 60,
          "via": 190,
          "to": 420
        }
      ],
      "default": 0.4
    }
  ]
}
