{
  "format": "sfxgen/1",
  "name": "Glass shatters",
  "description": "A small window pane smashed in with a bar, heard from inside a tiled kitchen. The bar meets the pane and the glass lets go all at once, a hard, bright crash: the sheet rings out as it cracks and bursts into a mass of pieces. Then the pieces keep coming, pouring out of the frame and raining onto the tiles: a sparse glitter of separate pieces, each heard on its own as it clinks and rings on, thin and high, with no hiss under it, and larger shards bouncing among them. It holds up for a while, then thins quickly to the last few splinters ringing faintly on their own.",
  "tags": ["impact", "glass", "shatter", "break", "window", "smash", "debris"],
  "duration": "auto",
  "seed": 21,
  "output": {
    "channels": 2
  },
