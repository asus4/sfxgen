{
  "format": "sfxgen/1",
  "name": "Grenade",
  "description": "A fragmentation grenade bursting in soft earth twenty metres off, in open country with a treeline. 0 ms: the detonation crack, hard and clipped. 3 ms: the blast body, a pressure wave that drops from 250 Hz to 75 Hz in 150 ms, overdriven so its harmonics carry on small speakers, with a ragged burst of dark noise as the ground lifts. 80 to 900 ms: steel fragments ring off stones as they land and clods of dirt patter down, thinning out. The treeline returns a soft roll.",
  "tags": ["explosion", "grenade", "blast", "frag", "bomb", "war", "boom", "shrapnel", "dirt"],
  "duration": "auto",
  "seed": 37,
  "tracks": [
    {
      "id": "crack",
      "note": "Detonation: 10 ms of clipped white noise. Sets the scale: high explosive, not a firework.",
      "gain": -7,
      "source": { "type": "noise", "color": "white", "env": { "attack": 0.0002, "decay": 0.035 }, "filter": { "mode": "highpass", "cutoff": 900 } },
      "fx": [{ "type": "drive", "mode": "hard", "amount": 18 }],
      "sends": { "trees": -10 }
    },
    {
      "id": "blast",
      "note": "The pressure wave: a falling sine, folded hard so it is a thick buzz-thump and not a kick drum. Weight at 100 to 300 Hz comes from the drive.",
      "start": 0.003,
      "source": { "type": "osc", "wave": "sine", "freq": [[0, 250], [0.15, 76]], "drift": 20, "env": { "attack": 0.001, "hold": 0.04, "decay": 0.5 } },
      "fx": [
        { "type": "drive", "id": "push", "mode": "fuzz", "amount": 20.5, "bias": 0.2, "tone": 2400 },
        { "type": "eq", "bands": [{ "mode": "lowcut", "freq": 65, "slope": "24" }] }
      ],
      "sends": { "trees": -8 }
    },
    {
      "id": "earth",
      "note": "The ground lifting: dark noise with a closing filter, uneven because of the wander. Fills between crack and thump.",
      "start": 0.005,
      "gain": -5,
      "source": {
        "type": "noise",
        "color": "brown",
        "env": { "attack": 0.004, "decay": 0.57 },
        "filter": {
          "mode": "lowpass",
          "q": 0.9,
          "cutoff": { "env": [[0, 5000], [0.1, 1400], [0.5, 300]], "mod": [{ "type": "wander", "rate": 18, "depth": 0.5, "unit": "oct" }] }
        }
      },
      "fx": [{ "type": "eq", "bands": [{ "mode": "lowcut", "freq": 70, "slope": "24" }] }],
      "sends": { "trees": -8 }
    },
    {
      "id": "fragments",
      "note": "Steel splinters hitting stones: a few bright metal pings scattered through the fall-out.",
      "start": 0.08,
      "gain": -11,
      "source": {
        "type": "particles",
        "distribution": "burst",
        "density": 44.7,
        "duration": 0.7,
        "grain": {
          "kind": "modal",
          "material": "metal",
          "shape": "bar",
          "lo": 2200,
          "hi": 8000,
          "decayLo": 0.02,
          "decayHi": 0.16,
          "levelJitter": 14,
          "pitchJitter": 2
        }
      },
      "sends": { "trees": -12 }
    },
    {
      "id": "dirt",
      "note": "Clods and soil raining back: dull, low ticks, more of them and for longer than the fragments.",
      "start": 0.12,
      "gain": -18,
      "source": {
        "type": "particles",
        "distribution": "burst",
        "density": 220,
        "duration": 0.849,
        "grain": { "kind": "tick", "lo": 300, "hi": 2400, "decayLo": 0.006, "decayHi": 0.03, "levelJitter": 14, "size": 0.7 }
      }
    }
  ],
  "buses": [{ "id": "trees", "fx": [{ "type": "reverb", "id": "roll", "space": "forest", "size": 40, "decay": 1.24, "predelay": 60 }], "gain": -13.8 }],
  "master": { "fx": [{ "type": "compressor", "threshold": -14, "ratio": 3, "attack": 0.02, "release": 0.25 }] },
  "controls": [
    {
      "id": "size",
      "label": "Charge",
      "hint": "A flash-bang's thump to a satchel charge: lower, longer, heavier.",
      "value": 0.5,
      "vary": 0.05,
      "targets": [
        { "path": "tracks.blast.source.freq", "mode": "mul", "from": 1.7, "to": 0.6 },
        { "path": "tracks.blast.source.env", "mode": "stretch", "from": 0.5, "to": 2 },
        { "path": "tracks.earth.source.env.decay", "from": 0.25, "to": 1.3 }
      ]
    },
    {
      "id": "punch",
      "label": "Punch",
      "hint": "A soft whump to a chest-hitting, distorted slam.",
      "value": 0.55,
      "targets": [{ "path": "tracks.blast.fx.push.amount", "from": 4, "to": 34, "curve": "linear" }, { "path": "tracks.crack.gain", "from": -18, "to": 2 }]
    },
    {
      "id": "fragments",
      "label": "Shrapnel",
      "hint": "A plain blast, or steel pinging off everything.",
      "value": 0.5,
      "vary": 0.15,
      "targets": [{ "path": "tracks.fragments.gain", "from": -28, "to": 6 }, { "path": "tracks.fragments.source.density", "from": 10, "to": 200 }]
    },
    {
      "id": "dirt",
      "label": "Dirt",
      "hint": "Hard ground, nothing thrown, to a fountain of soil coming down.",
      "value": 0.5,
      "vary": 0.15,
      "targets": [{ "path": "tracks.dirt.gain", "from": -36, "to": 0 }, { "path": "tracks.dirt.source.duration", "from": 0.4, "to": 1.8 }]
    },
    {
      "id": "distance",
      "label": "Roll",
      "hint": "Flat and dry, or echoing back off a far treeline.",
      "value": 0.45,
      "targets": [{ "path": "buses.trees.gain", "mode": "set", "from": -30, "to": 6 }, { "path": "buses.trees.fx.roll.decay", "from": 0.6, "to": 3 }]
    }
  ]
}
