{
  "format": "sfxgen/1",
  "name": "Big boom with debris",
  "description": "A fuel depot goes up a hundred metres away. The explosion is built the way film sound does it: a sharp, complete bang recorded 'small' (a crack, a drum-like thump and a burst of fire noise, 300 ms long) is played back at 40 % speed, so everything in it becomes slow, low and enormous: a 30 ms crack, a boom that takes most of a second to fall, and fire that roars for two. From 400 ms the debris comes down: big pieces first, clattering and bouncing, then smaller ones for three seconds.",
  "tags": ["explosion", "boom", "blast", "debris", "big", "destruction", "rubble", "cinematic", "bomb"],
  "duration": "auto",
  "seed": 44,
  "tracks": [
    {
      "id": "bang",
      "note": "The crack and fireball, before slowing: bright noise with a fast-closing filter. Varispeed turns its 0.35 s into nearly a second of roar.",
      "source": {
        "type": "noise",
        "color": "white",
        "env": { "attack": 0.0003, "hold": 0.01, "decay": 0.57 },
        "filter": {
          "mode": "lowpass",
          "q": 0.8,
          "cutoff": { "env": [[0, 18000], [0.02, 5000], [0.35, 350]], "mod": [{ "type": "wander", "rate": 40, "depth": 0.5, "unit": "oct" }] }
        }
      },
      "fx": [
        { "type": "drive", "mode": "tanh", "amount": 16 },
        { "type": "varispeed", "id": "scale", "rate": 0.516 },
        { "type": "eq", "bands": [{ "mode": "lowcut", "freq": 55, "slope": "24" }] }
      ],
      "sends": { "air": -9 },
      "gain": -9
    },
    {
      "id": "boom",
      "note": "The body: a drum skin struck hard, pitched like a tom, then slowed by the same factor so it lands at 60 to 150 Hz with its overtones intact.",
      "start": 0.004,
      "gain": 6,
      "source": {
        "type": "modal",
        "material": "skin",
        "shape": "membrane",
        "freq": [[0, 250], [0.12, 125]],
        "decay": 0.55,
        "position": 0.45,
        "brightness": 0.6,
        "exciter": { "kind": "mallet", "hardness": 0.8 }
      },
      "fx": [{ "type": "varispeed", "id": "scale", "rate": 0.516 }, { "type": "drive", "mode": "tube", "amount": 14, "tone": 4000 }],
      "sends": { "air": -7 }
    },
    {
      "id": "debris",
      "note": "What comes down: individual pieces of rubble, each a little struck object, big ones first (size ties pitch to level and ring).",
      "start": 0.4,
      "gain": -7,
      "source": {
        "type": "particles",
        "distribution": "burst",
        "density": 69.3,
        "duration": 3,
        "grain": {
          "kind": "modal",
          "material": "stone",
          "shape": "random",
          "lo": 180,
          "hi": 3200,
          "decayLo": 0.02,
          "decayHi": 0.12,
          "levelJitter": 16,
          "size": 0.8
        }
      },
      "sends": { "air": -12 }
    },
    {
      "id": "sheet",
      "note": "One large piece that lands late and bounces to rest: a dented metal sheet. A single identifiable event in the rain of rubble.",
      "start": 1.15,
      "gain": -14,
      "source": {
        "type": "particles",
        "distribution": "bounce",
        "interval": 0.34,
        "ratio": 0.62,
        "jitter": 0.3,
        "duration": 1.6,
        "grain": {
          "kind": "modal",
          "material": "metal",
          "shape": "plate",
          "lo": 310,
          "hi": 310,
          "decayLo": 0.25,
          "decayHi": 0.4,
          "pitchJitter": 1.5,
          "levelJitter": 3
        }
      },
      "sends": { "air": -10 }
    }
  ],
  "buses": [
    {
      "id": "air",
      "fx": [{ "type": "reverb", "id": "open", "space": "hall", "size": 55, "decay": 2.45, "damping": 0.7, "predelay": 70, "lowcut": 120 }],
      "gain": -12
    }
  ],
  "master": { "fx": [{ "type": "limiter", "gain": 8, "release": 0.15 }] },
  "controls": [
    {
      "id": "scale",
      "label": "Scale",
      "hint": "A car backfire-sized bang to a slow, city-shaking detonation.",
      "value": 0.55,
      "targets": [{ "path": "tracks.bang.fx.scale.rate", "from": 1, "to": 0.3 }, { "path": "tracks.boom.fx.scale.rate", "from": 1, "to": 0.3 }]
    },
    {
      "id": "fire",
      "label": "Fire",
      "hint": "A dry thud, or a long roaring fireball over it.",
      "value": 0.5,
      "targets": [{ "path": "tracks.bang.gain", "from": -20, "to": 2 }, { "path": "tracks.bang.source.env.decay", "from": 0.25, "to": 1.3 }]
    },
    {
      "id": "debris",
      "label": "Debris",
      "hint": "Nothing thrown, to a long rain of wreckage.",
      "value": 0.5,
      "vary": 0.15,
      "targets": [
        { "path": "tracks.debris.gain", "from": -24, "to": 10 },
        { "path": "tracks.debris.source.density", "from": 20, "to": 240 },
        { "path": "tracks.sheet.gain", "from": -30, "to": 2 }
      ]
    },
    {
      "id": "material",
      "label": "Wreckage",
      "hint": "What is falling.",
      "widget": "select",
      "value": 0,
      "options": [
        {
          "label": "Rubble",
          "set": {
            "tracks.debris.source.grain.material": "stone",
            "tracks.debris.source.grain.shape": "random",
            "tracks.debris.source.grain.lo": 180,
            "tracks.debris.source.grain.hi": 3200,
            "tracks.debris.source.grain.decayHi": 0.12
          }
        },
        {
          "label": "Timber",
          "set": {
            "tracks.debris.source.grain.material": "wood",
            "tracks.debris.source.grain.shape": "bar",
            "tracks.debris.source.grain.lo": 140,
            "tracks.debris.source.grain.hi": 1800,
            "tracks.debris.source.grain.decayHi": 0.18
          }
        },
        {
          "label": "Glass",
          "set": {
            "tracks.debris.source.grain.material": "glass",
            "tracks.debris.source.grain.shape": "plate",
            "tracks.debris.source.grain.lo": 1500,
            "tracks.debris.source.grain.hi": 9000,
            "tracks.debris.source.grain.decayHi": 0.3
          }
        },
        {
          "label": "Scrap metal",
          "set": {
            "tracks.debris.source.grain.material": "metal",
            "tracks.debris.source.grain.shape": "plate",
            "tracks.debris.source.grain.lo": 400,
            "tracks.debris.source.grain.hi": 5000,
            "tracks.debris.source.grain.decayHi": 0.6
          }
        }
      ]
    },
    {
      "id": "air",
      "label": "Open air",
      "hint": "Close and dry to rolling across a wide open site.",
      "value": 0.5,
      "targets": [{ "path": "buses.air.gain", "mode": "set", "from": -30, "to": 6 }, { "path": "buses.air.fx.open.decay", "from": 1, "to": 6 }]
    }
  ]
}
