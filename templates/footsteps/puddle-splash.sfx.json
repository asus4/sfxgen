{
  "format": "sfxgen/1",
  "name": "Footstep: puddle splash",
  "description": "One step of a rubber boot into a shallow street puddle. 0 ms: the sole slaps the water with a flat wet smack; under it the boot meets the asphalt with a dull thud; the water thrown out sideways lands as a spray of droplets from 40 to 400 ms, big blooping drops first, fine patter last; a hollow gulp as water closes in round the boot. Use the variations for a walk.",
  "tags": [
    "footstep",
    "step",
    "water",
    "puddle",
    "splash",
    "rain",
    "wet",
    "walk",
    "foley"
  ],
  "duration": "auto",
  "seed": 33,
  "output": {
    "channels": 2
  },
  "tracks": [
    {
      "id": "slap",
      "note": "Sole on water: a flat burst of noise that closes down fast, like a hand slapping a bath.",
      "source": {
        "type": "noise",
        "color": "white",
        "width": 0.5,
        "env": {
          "attack": 0.001,
          "hold": 0.006,
          "decay": 0.11
        },
        "filter": {
          "mode": "lowpass",
          "cutoff": [
            [
              0,
              9000
            ],
            [
              0.03,
              2600
            ],
            [
              0.11,
              700
            ]
          ],
          "q": 0.9
        }
      }
    },
    {
      "id": "drops",
      "note": "The thrown water landing back: droplets and bubbles, pitch rising as they get smaller.",
      "start": 0.04,
      "gain": -4,
      "source": {
        "type": "particles",
        "distribution": "burst",
        "density": 190,
        "duration": 0.38,
        "spread": 0.9,
        "grain": {
          "kind": "drop",
          "lo": [
            [
              0,
              500
            ],
            [
              0.35,
              1300
            ]
          ],
          "hi": [
            [
              0,
              2600
            ],
            [
              0.35,
              5200
            ]
          ],
          "decayLo": 0.012,
          "decayHi": 0.06,
          "levelJitter": 14,
          "size": 0.7
        }
      }
    },
    {
      "id": "gulp",
      "note": "Water closing round the boot: a hollow, rising bloop.",
      "start": 0.022,
      "gain": -8,
      "source": {
        "type": "osc",
        "wave": "sine",
        "freq": [
          [
            0,
            190
          ],
          [
            0.07,
            420
          ]
        ],
        "env": {
          "attack": 0.006,
          "decay": 0.09
        }
      },
      "fx": [
        {
          "type": "resonator",
          "mode": "tube",
          "freq": 240,
          "decay": 0.08,
          "brightness": 0.3,
          "mix": 0.5
        }
      ]
    },
    {
      "id": "ground",
      "note": "The street under the water.",
      "gain": -9,
      "source": {
        "type": "modal",
        "material": "stone",
        "shape": "plate",
        "freq": 117,
        "decay": 0.06,
        "brightness": 0.25,
        "modes": 8,
        "exciter": {
          "kind": "mallet",
          "hardness": 0.35
        }
      }
    }
  ],
  "master": {
    "fx": [
      {
        "type": "reverb",
        "id": "street",
        "space": "room",
        "size": 12,
        "decay": 0.5,
        "mix": 0.1
      }
    ]
  },
  "controls": [
    {
      "id": "depth",
      "label": "Depth",
      "hint": "A wet pavement to an ankle-deep puddle: more gulp, lower and longer.",
      "value": 0.45,
      "vary": 0.08,
      "targets": [
        {
          "path": "tracks.gulp.gain",
          "mode": "set",
          "from": -30,
          "to": 0,
          "curve": -0.455
        },
        {
          "path": "tracks.gulp.source.freq",
          "mode": "mul",
          "from": 1.6,
          "to": 0.6
        },
        {
          "path": "tracks.slap.source.env.decay",
          "mode": "set",
          "from": 0.06,
          "to": 0.22
        },
        {
          "path": "tracks.ground.gain",
          "mode": "set",
          "from": -3,
          "to": -20
        }
      ]
    },
    {
      "id": "splash",
      "label": "Splash",
      "hint": "A careful step, or a jump that throws water everywhere.",
      "value": 0.5,
      "vary": 0.12,
      "targets": [
        {
          "path": "tracks.drops.gain",
          "mode": "set",
          "from": -24,
          "to": 2,
          "curve": -0.467
        },
        {
          "path": "tracks.drops.source.density",
          "mode": "set",
          "from": 50,
          "to": 520
        },
        {
          "path": "tracks.drops.source.duration",
          "mode": "set",
          "from": 0.18,
          "to": 0.8
        }
      ]
    },
    {
      "id": "stomp",
      "label": "Stomp",
      "hint": "A soft wade in, or a hard flat slap.",
      "value": 0.5,
      "vary": 0.1,
      "targets": [
        {
          "path": "tracks.slap.source.filter.cutoff",
          "mode": "mul",
          "from": 0.4,
          "to": 1.8
        },
        {
          "path": "tracks.slap.source.env.attack",
          "mode": "set",
          "from": 0.012,
          "to": 0.0005
        },
        {
          "path": "tracks.slap.gain",
          "mode": "set",
          "from": -8,
          "to": 2
        }
      ]
    },
    {
      "id": "street",
      "label": "Street",
      "hint": "Open and dry-sounding, or between wet walls.",
      "value": 0.3,
      "targets": [
        {
          "path": "master.fx.street.mix",
          "mode": "set",
          "from": 0,
          "to": 0.35,
          "curve": "linear"
        }
      ]
    }
  ]
}
